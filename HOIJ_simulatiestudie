## methodenset; volgorde = manuscriptvolgorde (tab:sim-*)
methods_all <- c("wald_inf", "wald_hw", "mc_hw", "ij1", "hoij2", "boot",
                 "hoij2_sens", if (INCLUDE_BCA) "boot_bca")

run_dataset <- function(cell_row, s) {
  N_sim <- cell_row$N
  seed  <- SEED_BASE + 100000L * cell_row$cell + s     # [S9]
  set.seed(seed)
  syntax <- pop_syntax[[cell_row$spec]]
  truth  <- pseudo_truth[[paste(cell_row$dist, cell_row$spec, sep = "_")]]
  
  ## ── primaire fit, [S6] discard-and-redraw of keep_na ──
  t0 <- proc.time()[["elapsed"]]
  n_redraw <- 0L; fit_k <- NULL; dat_k <- NULL
  repeat {
    dat_try <- tryCatch({
      if (cell_row$dist == "nonnormal") {
        simulate_vita_data(N_sim, cell_row$spec, center = TRUE)
      } else simulateData(syntax, sample.nobs = N_sim)
    }, error = function(e) NULL)
    f_try <- if (is.null(dat_try)) NULL else tryCatch(
      sem(model_analysis, data = dat_try, estimator = "ML",
          se = "robust.huber.white"),
      error = function(e) NULL)
    conv_try <- tryCatch(
      !is.null(f_try) && isTRUE(lavInspect(f_try, "converged")),
      error = function(e) FALSE)
    ## [S12] redraw-criterium is UITSLUITEND convergentie, conform de
    ## manuscripttekst ("Data sets in which the primary model fit does
    ## not converge are discarded and redrawn") en conventie [C4]
    ## ("tellen, niet uitsluiten"). Toelaatbaarheid (post.check) wordt
    ## hieronder geregistreerd als inadmissible_primary, maar leidt
    ## NIET tot redraw: conditioneren op toelaatbaarheid maakt coverage
    ## conditioneel (de pseudo-ware waarde is onconditioneel) en
    ## verwijdert selectief de datasets waar parameterverdelings-
    ## scheefheid — het separerende contrast bij omega — het sterkst
    ## speelt, vooral bij N = 100.
    if (conv_try) {
      fit_k <- f_try; dat_k <- dat_try; break
    }
    n_redraw <- n_redraw + 1L
    if (FAILURE_MODE == "keep_na" || n_redraw >= MAX_REDRAW) break
  }
  if (is.null(fit_k)) {
    return(list(res = NULL,
                diag = data.frame(cell_row, s = s, n_redraw = n_redraw,
                                  converged = FALSE,
                                  inadmissible_primary = NA,
                                  boot_fail = NA_real_, boot_inadmiss = NA_real_,
                                  hoij_ok = FALSE, fallb_Hobs = 0L,
                                  fallb_alpha = 0L, fallb_deriv = 0L,
                                  alpha_spread = NA_real_,
                                  frac_damped = NA_real_, mean_s = NA_real_,
                                  hoij_frac_inadmiss = NA_real_)))
  }
  t_fit <- elapsed_sec(t0)
  
  ## [S12] toelaatbaarheid primaire fit: registreren, niet uitsluiten [C4]
  admiss_primary <- tryCatch(
    isTRUE(suppressWarnings(lavInspect(fit_k, "post.check"))),
    error = function(e) TRUE)
  
  theta0   <- coef(fit_k, type = "free")
  th_names <- names(theta0)
  D        <- length(theta0)
  ## indices variantieparameters (voor toelaatbaarheid HOIJ-replicaten)
  spl <- strsplit(th_names, "~~", fixed = TRUE)
  var_idx <- which(vapply(spl, function(z) length(z) == 2 && z[1] == z[2],
                          logical(1)))
  
  ## ── covariantiematrices [S7] ──
  V_hw  <- tryCatch(lavInspect(fit_k, "vcov")[th_names, th_names, drop = FALSE],
                    error = function(e) NULL)
  V_inf <- tryCatch(lavTech(fit_k, "inverted.information.expected") / N_sim,
                    error = function(e) NULL)
  
  ## ── Wald--delta-intervallen ──
  t0 <- proc.time()[["elapsed"]]
  ci_wald_inf <- lapply(fn_names, function(fn)
    if (is.null(V_inf)) c(lo = NA_real_, hi = NA_real_) else
      wald_ci(functionals_scalar[[fn]], theta0, V_inf))
  t_winf <- elapsed_sec(t0)
  t0 <- proc.time()[["elapsed"]]
  ci_wald_hw <- lapply(fn_names, function(fn)
    if (is.null(V_hw)) c(lo = NA_real_, hi = NA_real_) else
      wald_ci(functionals_scalar[[fn]], theta0, V_hw))
  t_whw <- elapsed_sec(t0)
  names(ci_wald_inf) <- names(ci_wald_hw) <- fn_names
  
  ## ── Monte Carlo (HW) ──
  t0 <- proc.time()[["elapsed"]]
  draws_mc <- NULL
  if (!is.null(V_hw)) {
    L <- tryCatch(t(chol(V_hw + diag(1e-10, D))), error = function(e) NULL)
    if (!is.null(L)) {
      Z <- matrix(rnorm(R_MC * D), R_MC, D)
      draws_mc <- sweep(Z %*% t(L), 2, theta0, "+")
      colnames(draws_mc) <- th_names
    }
  }
  t_mc <- elapsed_sec(t0)
  
  ## ── [S5] gedeelde gewichten: EEN countmatrix voor boot, IJ1, HOIJ-2 ──
  ## [S15] rmultinom(B, N, 1/N) is distributioneel identiek aan
  ## sample.int + tabulate (multinomiale bootstrapgewichten), maar
  ## zonder de N*B-indexmatrix. RNG-stroom verandert t.o.v. pre-[S15].
  t0 <- proc.time()[["elapsed"]]
  W_counts <- t(rmultinom(B, size = N_sim, prob = rep(1, N_sim)))  # B x N
  dW <- W_counts - 1L                                              # delta_w
  t_w <- elapsed_sec(t0)
  
  ## ── exacte bootstrap via covmatrix-route (sample.cov i.p.v. raw data) ──
  ## Voor ML-schatting zonder mean-structuur is de steekproef-covariatie-
  ## matrix de volledige sufficient statistic. Fitten op de gewogen
  ## covmatrix (p×p) is equivalent aan fitten op geresamplede data (N×p),
  ## maar ~3-5x sneller omdat lavaan geen per-observatie berekeningen doet.
  t0 <- proc.time()[["elapsed"]]
  boot_th <- matrix(NA_real_, B, D, dimnames = list(NULL, th_names))
  n_boot_fail <- 0L; n_boot_inadmiss <- 0L
  PT_boot <- make_boot_partable(fit_k)                       # [S14] eenmalig
  dat_mat <- as.matrix(dat_k)                                # N x p
  mu_all  <- W_counts %*% dat_mat / N_sim                    # B x p: gewogen gemiddelden
  for (r in 1:B) {
    ## [S15] Gewogen covmatrix zonder sweep-allocatie:
    ## sum_i w_i x_i x_i' - N mu_w mu_w', gedeeld door N-1. Algebraisch
    ## exact gelijk aan cov(dat_k[idx,]) met dezelfde gewichten.
    w   <- W_counts[r, ]
    S_b <- (crossprod(dat_mat * w, dat_mat) -
              N_sim * tcrossprod(mu_all[r, ])) / (N_sim - 1)
    S_b <- (S_b + t(S_b)) / 2          # [S15] symmetrisatie (fp-ruis 1e-16)
    fit_b <- fit_boot_cov(PT_boot, S_b, N_sim, iter.max = 150L)   # [S14]
    if (is.null(fit_b)) { n_boot_fail <- n_boot_fail + 1L; next }
    adm <- tryCatch(isTRUE(suppressWarnings(lavInspect(fit_b, "post.check"))),
                    error = function(e) TRUE)
    if (!adm) { n_boot_inadmiss <- n_boot_inadmiss + 1L; next }   # [S6]
    th_b <- tryCatch(coef(fit_b, type = "free"), error = function(e) NULL)
    if (!is.null(th_b) && length(th_b) == D) boot_th[r, ] <- th_b
  }
  t_boot <- elapsed_sec(t0)
  
  ## ── IJ1: lineaire benadering over ALLE B gewichtsvectoren [S6] ──
  t0 <- proc.time()[["elapsed"]]
  ij_th <- NULL; C_mat <- NULL; H.inv <- NULL; Scores <- NULL
  Scores <- tryCatch(lavScores(fit_k, scaling = TRUE), error = function(e) NULL)
  H.inv  <- tryCatch(lavTech(fit_k, "inverted.information.observed"),
                     error = function(e) NULL)
  if (!is.null(Scores) && !is.null(H.inv)) {
    G_mat <- dW %*% Scores
    C_mat <- G_mat %*% H.inv
    ij_th <- sweep(-C_mat, 2, theta0, "+")
    colnames(ij_th) <- th_names
  }
  t_scores <- elapsed_sec(t0)
  
  ## ── HOIJ-2: setup (J_i, alpha, T) + replicatielus [S8/S11] ──
  hoij_th <- NULL
  fallb_Hobs <- 0L; fallb_alpha <- 0L; fallb_deriv <- 0L
  alpha_spread <- NA_real_
  frac_damped <- NA_real_; mean_s <- NA_real_
  hoij_inadmiss <- NULL
  t_hsetup <- 0; t_hloop <- 0
  if (!is.null(C_mat) && N_sim >= N_MIN_HOIJ) {
    t0 <- proc.time()[["elapsed"]]
    H_obs <- tryCatch(lavTech(fit_k, "information.observed"),
                      error = function(e) NULL)
    if (is.null(H_obs)) {
      fallb_Hobs <- 1L
    } else {
      grad_F <- make_grad_F(fit_k)
      cal <- tryCatch(calibrate_alpha(grad_F, theta0, H_obs),
                      error = function(e) NULL)
      if (!is.null(cal) && is.finite(cal$spread)) alpha_spread <- cal$spread
      if (is.null(cal) || !is.finite(cal$alpha) ||
          cal$spread > ALPHA_SPREAD_TOL) {
        fallb_alpha <- 1L
      } else {
        T_arr <- tryCatch(compute_T_tensor_grad(grad_F, theta0, cal$alpha),
                          error = function(e) NULL)
        J_all <- tryCatch(compute_all_J(fit_k, theta0, delta = 1e-5),
                          error = function(e) NULL)
        if (is.null(T_arr) || is.null(J_all)) {
          fallb_deriv <- 1L
        } else {
          t_hsetup <- elapsed_sec(t0)
          t0 <- proc.time()[["elapsed"]]
          Tmat     <- matrix(T_arr, nrow = D)
          J_all_2d <- matrix(J_all, nrow = N_sim, ncol = D * D)
          JW_2d    <- (dW %*% J_all_2d) / N_sim
          HT       <- H.inv %*% Tmat
          hoij_th  <- matrix(NA_real_, B, D, dimnames = list(NULL, th_names))
          s_vec    <- rep(NA_real_, B)
          for (i in 1:B) {
            c_vec  <- C_mat[i, ]
            J_dw_i <- matrix(JW_2d[i, ], D, D)
            Bc     <- drop(H.inv %*% J_dw_i %*% c_vec)
            Ac     <- 0.5 * drop(HT %*% as.vector(tcrossprod(c_vec)))
            d1     <- -c_vec
            d2     <- Bc - Ac
            n1 <- sqrt(sum(d1^2)); n2 <- sqrt(sum(d2^2))
            sdmp <- if (n2 > 0) min(1, KAPPA_DAMP * n1 / n2) else 1
            s_vec[i] <- sdmp
            hoij_th[i, ] <- theta0 + d1 + sdmp * d2       # [C2]
          }
          frac_damped <- mean(s_vec < 1, na.rm = TRUE)
          mean_s      <- mean(s_vec, na.rm = TRUE)
          ## toelaatbaarheid per replicaat: negatieve variantieparameter
          hoij_inadmiss <- apply(hoij_th[, var_idx, drop = FALSE] < 0, 1, any)
          t_hloop <- elapsed_sec(t0)
        }
      }
    }
    if (is.null(hoij_th)) t_hsetup <- elapsed_sec(t0)
  }
  
  ## IJ-acceleratie voor optionele BCa (geen delete-1-herfits)
  acc_th <- if (INCLUDE_BCA && !is.null(Scores) && !is.null(H.inv))
    sweep(Scores %*% H.inv, 2, theta0, "+") else NULL
  if (!is.null(acc_th)) colnames(acc_th) <- th_names
  
  ## ── CI's + registratie per functionaal x methode ──
  min_n <- max(40L, ceiling(0.5 * B))
  out <- vector("list", length(fn_names) * length(methods_all)); oi <- 0L
  for (fn in fn_names) {
    f_s <- functionals_scalar[[fn]]; f_v <- functionals_vec[[fn]]
    fn_hat <- tryCatch(f_s(theta0), error = function(e) NA_real_)
    tv <- truth[[fn]]
    
    mc_vals   <- if (!is.null(draws_mc)) f_v(draws_mc, th_names) else NULL
    boot_ok   <- is.finite(boot_th[, 1])
    boot_vals <- f_v(boot_th, th_names)
    ij_vals   <- if (!is.null(ij_th))   f_v(ij_th, th_names)   else NULL
    hoij_vals <- if (!is.null(hoij_th)) f_v(hoij_th, th_names) else NULL
    
    cis <- list(
      wald_inf = ci_wald_inf[[fn]],
      wald_hw  = ci_wald_hw[[fn]],
      mc_hw    = if (is.null(mc_vals)) c(NA_real_, NA_real_) else
        perc_ci(mc_vals, min_n = max(40L, ceiling(0.5 * R_MC))),
      ij1      = if (is.null(ij_vals)) c(NA_real_, NA_real_) else
        perc_ci(ij_vals, min_n = min_n),
      ## [S6] conventie: niet-toelaatbare replicaatwaarden BLIJVEN erin
      hoij2    = if (is.null(hoij_vals)) c(NA_real_, NA_real_) else
        perc_ci(hoij_vals, min_n = min_n),
      boot     = perc_ci(boot_vals, min_n = min_n),
      ## sensitiviteitscheck: toelaatbaarheidsfilter op replicaatniveau
      hoij2_sens = if (is.null(hoij_vals)) c(NA_real_, NA_real_) else
        perc_ci(hoij_vals[!hoij_inadmiss], min_n = min_n)
    )
    if (INCLUDE_BCA)
      cis$boot_bca <- bca_ci(boot_vals, fn_hat,
                             if (is.null(acc_th)) NULL else
                               f_v(acc_th, th_names),
                             min_n = min_n)
    
    tms <- c(
      wald_inf   = as.numeric(t_fit + t_winf),
      wald_hw    = as.numeric(t_fit + t_whw),
      mc_hw      = as.numeric(t_fit + t_mc),
      ij1        = as.numeric(t_fit + t_w + t_scores),
      hoij2      = as.numeric(t_fit + t_w + t_scores + t_hsetup + t_hloop),  # [S8]
      boot       = as.numeric(t_fit + t_w + t_boot),
      hoij2_sens = as.numeric(t_fit + t_w + t_scores + t_hsetup + t_hloop),
      boot_bca   = as.numeric(t_fit + t_w + t_boot))
    
    ffin <- c(
      wald_inf = NA_real_, wald_hw = NA_real_,
      mc_hw = if (is.null(mc_vals)) NA_real_ else mean(is.finite(mc_vals)),
      ij1   = if (is.null(ij_vals)) NA_real_ else mean(is.finite(ij_vals)),
      hoij2 = if (is.null(hoij_vals)) NA_real_ else mean(is.finite(hoij_vals)),
      boot  = mean(boot_ok),
      hoij2_sens = if (is.null(hoij_vals)) NA_real_ else
        mean(is.finite(hoij_vals) & !hoij_inadmiss),
      boot_bca = mean(boot_ok))
    
    for (m in methods_all) {
      lo <- unname(cis[[m]][1]); hi <- unname(cis[[m]][2])
      oi <- oi + 1L
      out[[oi]] <- data.frame(
        cell = cell_row$cell, N = N_sim, dist = cell_row$dist,
        spec = cell_row$spec, s = s, functional = fn, method = m,
        lo = lo, hi = hi, est = fn_hat, truth = tv,
        covered   = if (is.finite(lo) && is.finite(hi))
          as.integer(tv >= lo & tv <= hi) else NA_integer_,
        miss_left  = if (is.finite(lo)) as.integer(tv < lo)  else NA_integer_,
        miss_right = if (is.finite(hi)) as.integer(tv > hi)  else NA_integer_,
        width = if (is.finite(lo) && is.finite(hi)) hi - lo else NA_real_,
        time_s = as.numeric(tms[[m]]), frac_finite = as.numeric(ffin[[m]]),
        stringsAsFactors = FALSE)
    }
  }
  
  diag <- data.frame(
    cell_row, s = s, n_redraw = n_redraw, converged = TRUE,
    inadmissible_primary = !admiss_primary,
    boot_fail = n_boot_fail / B, boot_inadmiss = n_boot_inadmiss / B,
    hoij_ok = !is.null(hoij_th),
    fallb_Hobs = fallb_Hobs, fallb_alpha = fallb_alpha,
    fallb_deriv = fallb_deriv, alpha_spread = alpha_spread,
    frac_damped = frac_damped, mean_s = mean_s,
    hoij_frac_inadmiss = if (is.null(hoij_inadmiss)) NA_real_ else
      mean(hoij_inadmiss))
  list(res = do.call(rbind, out), diag = diag)
}


