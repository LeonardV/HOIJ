## [S13] type = "PSOCK" expliciet: op Windows is dit de enige clustervorm
## (geen fork); elke worker is een vers R-proces waarin lavaan en alle
## geexporteerde objecten eenmalig worden geladen. De BLAS-guard voorkomt
## oversubscription (ncores processen x meerdere BLAS-threads) wanneer R
## aan OpenBLAS/MKL gekoppeld is; bij de standaard Windows-R (referentie-
## BLAS, single-threaded) is hij een no-op.
cl <- makeCluster(ncores, type = "PSOCK")
clusterEvalQ(cl, {
  suppressPackageStartupMessages(library(lavaan))
  suppressPackageStartupMessages(library(covsim))
  suppressPackageStartupMessages(library(rvinecopulib))
  if (requireNamespace("RhpcBLASctl", quietly = TRUE)) {
    RhpcBLASctl::blas_set_num_threads(1)
    RhpcBLASctl::omp_set_num_threads(1)
  }
  NULL
})
clusterExport(cl, c("design", "tasks", "run_dataset", "pop_syntax",
                    "Sigma_by_spec", "vita_by_spec", "ov_names",
                    "pseudo_truth", "model_analysis", "fn_names",
                    "functionals_scalar", "functionals_vec",
                    "methods_all", "S", "B", "R_MC", "ALPHA",
                    "KAPPA_DAMP", "N_MIN_HOIJ", "ALPHA_SPREAD_TOL",
                    "MAIN_FNS", "SECONDARY_FNS", "TABLE_FNS",
                    "FAILURE_MODE", "MAX_REDRAW", "INCLUDE_BCA",
                    "SEED_BASE", "make_boot_partable",
                    "simulate_vita_data", "elapsed_sec", "moment_diag",
                    "var_speed_scalar", "var_speed_vec",
                    "compute_loglik_casewise", "compute_all_J",
                    "make_grad_F", "calibrate_alpha",
                    "compute_T_tensor_grad", "num_grad_f", "wald_ci",
                    "perc_ci", "bca_ci", "fit_boot_cov"))

## chunksgewijs met incrementeel wegschrijven. [S13] Binnen een chunk
## wordt parLapplyLB (load balancing) gebruikt: taakduur varieert sterk
## (N = 100 vs 500; redraws; HOIJ-setup), en statische verdeling laat
## workers idle wachten op de traagste. Omdat de seed PER TAAK binnen
## run_dataset wordt gezet [S9], is het resultaat onafhankelijk van de
## scheduling exact reproduceerbaar — de reden om eerder parLapply te
## verkiezen [C6] vervalt daarmee. De taakvolgorde wordt bovendien
## deterministisch geschud zodat trage (N = 500) en snelle (N = 100)
## taken binnen elke chunk gemengd zijn (kleinere staart per chunk).
set.seed(SEED_BASE)
task_order <- sample(seq_len(nrow(tasks)))
CHUNK <- max(ncores * 20L, 48L)   # [S16] minder chunk-barrieres
chunks <- split(task_order, ceiling(seq_along(task_order) / CHUNK))
res_list <- vector("list", length(chunks))
t_start <- proc.time()[3]
for (ch in seq_along(chunks)) {
  res_list[[ch]] <- parLapplyLB(cl, chunks[[ch]], run_task)
  el <- proc.time()[3] - t_start
  done <- sum(lengths(chunks[seq_len(ch)]))   # [S13] aantal, niet max-id
  cat(sprintf("  chunk %d/%d klaar | taken %d/%d | %.1f min verstreken | ETA %.1f min\n",
              ch, length(chunks), done, nrow(tasks), el/60,
              el/60 * (nrow(tasks)/done - 1)))
  ## [S16] per chunk een eigen bestand; herstart-samenvoeging:
  ## res_list <- lapply(sort(list.files(out_dir, "hoij_sim_partial_chunk",
  ##                    full.names = TRUE)), readRDS)
  saveRDS(res_list[[ch]],
          file.path(out_dir, sprintf("hoij_sim_partial_chunk%03d.rds", ch)))
}
stopCluster(cl)

flat    <- unlist(res_list, recursive = FALSE)
results <- do.call(rbind, lapply(flat, `[[`, "res"))
diags   <- do.call(rbind, lapply(flat, `[[`, "diag"))

if (is.null(results) || nrow(results) == 0L) {
  saveRDS(list(flat = flat, diags = diags, design = design),
          file.path(out_dir, "hoij_sim_failed_no_results.rds"))
  stop("Geen enkele geldige result-rij geproduceerd. Zie hoij_sim_failed_no_results.rds en diags voor de oorzaak.")
