## [S1] populatiesyntax met vaste waarden — immuun voor de est/ustart-
## valkuil van simulateData() met parTables [C13]
build_pop_syntax <- function(fit, extra = NULL) {
  pt <- parTable(fit)
  pt <- pt[pt$op %in% c("=~", "~", "~~"), , drop = FALSE]
  lines <- sprintf("%s %s %.12g*%s", pt$lhs, pt$op, pt$est, pt$rhs)
  paste(c(lines, extra), collapse = "\n")
}
pop_syntax_correct <- build_pop_syntax(fit_hs)

