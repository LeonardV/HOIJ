}

num_grad_f <- function(f, theta, delta = 1e-5) {
  sapply(seq_along(theta), function(k) {
    tp <- theta; tp[k] <- tp[k] + delta
    tm <- theta; tm[k] <- tm[k] - delta
    tryCatch((f(tp) - f(tm)) / (2 * delta), error = function(e) NA_real_)
  })
}

wald_ci <- function(f, theta0, vcov_mat, alpha = ALPHA) {
  grad <- num_grad_f(f, theta0)
  v    <- max(0, as.numeric(t(grad) %*% vcov_mat %*% grad))
  se   <- sqrt(v)
  z    <- qnorm(1 - alpha / 2)
  fn_v <- tryCatch(f(theta0), error = function(e) NA_real_)
  c(lo = fn_v - z * se, hi = fn_v + z * se)
}

perc_ci <- function(vals, alpha = ALPHA, min_n = 40L) {
  vals <- vals[is.finite(vals)]
  if (length(vals) < min_n) return(c(lo = NA_real_, hi = NA_real_))
  q <- quantile(vals, c(alpha/2, 1 - alpha/2), names = FALSE, type = 7)
  c(lo = q[1], hi = q[2])
}

bca_ci <- function(boot_vals, theta_hat, acc_vals, alpha = ALPHA, min_n = 40L) {
  boot_vals <- boot_vals[is.finite(boot_vals)]
  if (length(boot_vals) < min_n || !is.finite(theta_hat))
    return(c(lo = NA_real_, hi = NA_real_))
  p0 <- mean(boot_vals < theta_hat)
  ## Clamp tegen oneindige z0 wanneer alle bootstrapwaarden aan één kant liggen.
  p0 <- min(max(p0, 1 / (length(boot_vals) + 1)),
            length(boot_vals) / (length(boot_vals) + 1))
  z0  <- qnorm(p0)
  z_a <- qnorm(1 - alpha/2)
  acc <- 0
  if (!is.null(acc_vals)) {
    av <- acc_vals[is.finite(acc_vals)]
    if (length(av) >= 10) {
      d <- mean(av) - av
      acc <- sum(d^3) / (6 * (sum(d^2))^1.5)
      if (!is.finite(acc)) acc <- 0
    }
  }
  p_lo <- pnorm(z0 + (z0 - z_a) / (1 - acc * (z0 - z_a)))
  p_hi <- pnorm(z0 + (z0 + z_a) / (1 - acc * (z0 + z_a)))
  q <- quantile(boot_vals, c(p_lo, p_hi), names = FALSE, type = 7)
  c(lo = q[1], hi = q[2])
}


## [S14] Bootstrap-refit via pre-geparste parametertabel.
## make_boot_partable() wordt EENMALIG per dataset aangeroepen: het neemt
## de parTable van de primaire fit en zet ustart/start op de ML-schattingen,
## zodat (i) lavaan de modelsyntax niet B keer parseert en (ii) elke
## replicatie warm start op theta_hat. De vrije-parametervolgorde en
## labels (a, b, c) blijven identiek aan de primaire fit, dus coef()
## levert dezelfde namen als th_names.
make_boot_partable <- function(fit_k) {
  PT <- parTable(fit_k)
  PT$ustart <- PT$est
  PT$start  <- PT$est
  PT$se     <- NULL
  PT
}

## [S14] Fit op gewogen covmatrix met uitgeschakeld nevenwerk:
## h1/baseline-model en de interne start/gradient/post-checks zijn voor
## de percentile-bootstrap overbodig. LET OP: check.post = FALSE schakelt
## alleen de check IN de fitter uit; de expliciete
## lavInspect(fit_b, "post.check") in de B-lus blijft de [S6]-telling
## van boot_inadmiss verzorgen.
fit_boot_cov <- function(PT_boot, S_b, N_sim, iter.max = 150L) {
  fb <- tryCatch(
    sem(model = PT_boot,
        sample.cov  = S_b,
        sample.nobs = N_sim,
        estimator   = "ML",
        se = "none", test = "none",
        h1 = FALSE, baseline = FALSE,
        check.gradient = FALSE, check.start = FALSE, check.post = FALSE,
        control = list(iter.max = iter.max)),
    error = function(e) NULL)
  if (!is.null(fb)) {
    conv <- tryCatch(isTRUE(lavInspect(fb, "converged")),
                     error = function(e) FALSE)
    if (conv) return(fb)
  }
  NULL
}

## [S14] Eenmalige pre-flight: verifieert dat de parTable-route (a) werkt
## in de aanwezige lavaan-versie, (b) dezelfde oplossing geeft als een
## koude string-fit op dezelfde covmatrix, en (c) coefnamen levert die
## exact matchen met de primaire fit. Voorkomt dat een versieprobleem
## pas na uren als ~100% boot_fail zichtbaar wordt.
## [S14a] Pre-flight herzien na diagnose (juli 2026): de oorspronkelijke
## versie vergeleek de parTable-route (warme start, iter.max = 150) met
## een KOUDE-start string-fit bij hetzelfde lage iter.max. Diagnostiek
## liet zien dat beide model-specificaties (parTable en string), streng
## geconvergeerd (iter.max = 2000, rel.tol = 1e-10), exact hetzelfde
## optimum vinden (verschil = 0) — er is dus geen routefout. Bij
## iter.max = 150 zat de parTable/warme-startroute 4.8e-06 van dat
## optimum, de koude-start-stringroute 1.7e-05: de warme start
## convergeert SNELLER, niet trager. Het eerdere verschil van 2.2e-05
## tussen de twee routes was dus grotendeels onderconvergentie van de
## stringroute bij lage iter.max, niet een fout in [S14]. De test
## vergelijkt daarom nu de productieroute (parTable, iter.max = 150)
## tegen een streng geconvergeerde ARBITER, in plaats van tegen een
## eveneens mogelijk onderconvergeerde koude-startfit bij gelijk
## iter.max. tol = 1e-4 geeft ~20x marge t.o.v. de waargenomen
## optimizer-precisie (4.8e-06) en blijft ruim scherper dan de
## MC-fout op een bootstrap-percentiel bij B = 1000 (orde 1e-3), zodat
## echte routefouten (verwisselde parameterlabels, verkeerd model)
## nog steeds worden opgevangen.
check_bootstrap_refit_route <- function(tol = 1e-4) {
  cat("\n── Pre-flight bootstrap-refitroute [S14] ──\n")
  set.seed(SEED_BASE + 909L)
  dat0 <- simulateData(pop_syntax$correct, sample.nobs = 100L)
  fit0 <- sem(model_analysis, data = dat0, estimator = "ML",
              se = "robust.huber.white")
  stopifnot(lavInspect(fit0, "converged"))
  th0 <- coef(fit0, type = "free")
  
  idx <- sample.int(nrow(dat0), nrow(dat0), replace = TRUE)
  S_b <- cov(as.matrix(dat0)[idx, , drop = FALSE])
  
  PT0   <- make_boot_partable(fit0)
  fb_pt <- fit_boot_cov(PT0, S_b, nrow(dat0))          # productie-instelling
  if (is.null(fb_pt)) stop("parTable-refitroute convergeert niet in pre-flight.")
  th_pt <- coef(fb_pt, type = "free")
  stopifnot(identical(names(th_pt), names(th0)))
  cat("  coefnamen identiek aan primaire fit: OK\n")
  
  ## Arbiter: zelfde model (parTable), veel ruimere iter.max en scherpere
  ## rel.tol. rel.tol = 1e-10 (i.p.v. 1e-12) vermijdt de spurieuze
  ## "solution has NOT been found"-waarschuwing die bij 1e-12 optreedt
  ## zodra nlminb de floating-point-precisiegrens bereikt.
  arb <- sem(model = PT0, sample.cov = S_b, sample.nobs = nrow(dat0),
             estimator = "ML", se = "none", test = "none",
             control = list(iter.max = 2000L, eval.max = 4000L,
                            rel.tol = 1e-10))
  if (!isTRUE(lavInspect(arb, "converged"))) {
    warning("Arbiter-fit in pre-flight niet als geconvergeerd gemarkeerd; ",
            "wordt desondanks als referentie gebruikt (zie [S14a]-noot).",
            call. = FALSE)
  }
  th_arb <- coef(arb, type = "free")[names(th_pt)]
  d <- max(abs(th_pt - th_arb))
  cat(sprintf("  max |theta_pt(iter.max=150) - theta_arbiter| = %.2e (tol %.0e)  %s\n",
              d, tol, if (d < tol) "OK" else "FOUT"))
  if (d >= tol)
    stop("parTable-route wijkt te veel af van de streng geconvergeerde arbiter; niet doorgaan.")
  invisible(TRUE)
}

safe_aggregate <- function(formula, data, FUN, ..., label = deparse(formula)) {
  vars <- all.vars(formula)
  missing_vars <- setdiff(vars, names(data))
  if (length(missing_vars) > 0L) {
    stop(sprintf("Aggregatie '%s' kan niet: ontbrekende variabele(n): %s",
                 label, paste(missing_vars, collapse = ", ")))
  }
  d <- data[complete.cases(data[vars]), , drop = FALSE]
  if (nrow(d) == 0L) {
    stop(sprintf("Aggregatie '%s' kan niet: geen geldige rijen.", label))
  }
  aggregate(formula, data = d, FUN = FUN, ...)
}


