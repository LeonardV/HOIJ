lnorm_meanlog_for_variance <- function(target_var, sdlog = VITA_SDLOG) {
  ## Var[lognormal(meanlog, sdlog)] = (exp(sdlog^2)-1) * exp(2*meanlog + sdlog^2)
  0.5 * (log(target_var / (exp(sdlog^2) - 1)) - sdlog^2)
}

make_vita_margins <- function(Sigma_target, sdlog = VITA_SDLOG) {
  vars <- diag(Sigma_target)
  if (any(vars <= 0)) stop("VITA-margins vereisen positieve variances.")
  lapply(vars, function(v) {
    list(distr = "lnorm", meanlog = lnorm_meanlog_for_variance(v, sdlog), sdlog = sdlog)
  })
}

calibrate_vita <- function(Sigma_target, label, seed_offset = 0L) {
  cat(sprintf("\nCalibratie VITA/covsim voor %s (Nmax = %d, sdlog = %.4f; skew≈%.2f, excess≈%.2f) ...\n",
              label, VITA_NMAX, VITA_SDLOG, VITA_SKEW_TARGET, VITA_EXKURT_TARGET))
  set.seed(SEED_BASE + 7000L + seed_offset)
  margins <- make_vita_margins(Sigma_target)
  vc <- covsim::vita(
    margins = margins,
    sigma.target = Sigma_target,
    family_set = c("clayton", "gauss", "joe", "gumbel", "frank"),
    Nmax = VITA_NMAX,
    verbose = FALSE,
    cores = 1L
  )
  vc
}

