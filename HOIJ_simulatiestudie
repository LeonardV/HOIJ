make_Sigma_mis <- function(delta) {
  Sm <- Sigma_pop
  i <- MISSPEC_PAIR[1]; j <- MISSPEC_PAIR[2]
  Sm[i, j] <- Sm[i, j] + delta
  Sm[j, i] <- Sm[i, j]
  Sm
}

## [S4] populatie-RMSEA van het analysemodel bij gegeven delta:
## fit op Sigma (sample.cov, groot N); F0 = 2*fmin; RMSEA = sqrt(F0/df)
pop_rmsea <- function(delta) {
  Sm <- make_Sigma_mis(delta)
  pd <- tryCatch({ chol(Sm); TRUE }, error = function(e) FALSE)
  if (!pd) return(10)      # eindig groot: uniroot() kan niet met Inf overweg
  f <- tryCatch(
    sem(model_analysis, sample.cov = Sm, sample.nobs = N_PSEUDO,
        estimator = "ML", se = "none"),
    error = function(e) NULL)
  if (is.null(f) || !lavInspect(f, "converged")) return(10)
  F0 <- 2 * unname(fitMeasures(f, "fmin"))
  df <- unname(fitMeasures(f, "df"))
  sqrt(max(F0, 0) / df)
}

