simulate_vita_data <- function(N, spec, center = TRUE) {
  X <- rvinecopulib::rvine(N, vita_by_spec[[spec]])
  X <- as.data.frame(X)
  names(X) <- ov_names
  ## ML zonder meanstructure gebruikt alleen de covariantiematrix. Centreren
  ## stabiliseert de numeriek berekende sample.cov en houdt de schaal helder.
  if (center) X[] <- lapply(X, function(z) as.numeric(z - mean(z)))
  X
}

moment_diag <- function(dat) {
  data.frame(
    skew = sapply(dat, function(x) mean((x - mean(x))^3) / sd(x)^3),
    exkurt = sapply(dat, function(x) mean((x - mean(x))^4) / sd(x)^4 - 3)
  )
}



