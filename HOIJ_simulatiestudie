# ─────────────────────────────────────────────────────────────────────────────

selftest <- function(tol_rel = 0.01) {
  cat("\n── Pre-flight zelftest (lavaan ",
      as.character(packageVersion("lavaan")), ") ──\n", sep = "")
  fit <- sem("f =~ x1 + x2 + x3", data = HolzingerSwineford1939,
             estimator = "ML", se = "robust.huber.white")
  th0 <- coef(fit, type = "free"); D <- length(th0)
  N   <- nrow(fit@Data@X[[1]])
  h <- 1e-6
  ## (a) lavScores(scaling=TRUE) = -s_i/N
  S_num <- sapply(1:D, function(k) {
    tp <- th0; tp[k] <- tp[k] + h; tm <- th0; tm[k] <- tm[k] - h
    (compute_loglik_casewise(fit, tp) - compute_loglik_casewise(fit, tm)) / (2*h)
  })
  Sc <- lavScores(fit, scaling = TRUE)
  r_sc <- median(as.numeric(Sc) / as.numeric(S_num)) * N
  ok_a <- is.finite(r_sc) && abs(r_sc + 1) < tol_rel
  cat(sprintf("  (a) lavScores-schaal   : N*ratio = %+.6f (verwacht -1)  %s\n",
              r_sc, if (ok_a) "OK" else "FOUT"))
  ## (b) information.observed = J_som/N
  J_sum <- apply(compute_all_J(fit, th0, delta = 1e-5), c(2,3), sum)
  H_obs <- lavTech(fit, "information.observed")
  r_H <- median(as.numeric(H_obs) / as.numeric(J_sum)) * N
  ok_b <- is.finite(r_H) && abs(r_H - 1) < tol_rel
  cat(sprintf("  (b) info.observed      : N*ratio = %+.6f (verwacht +1)  %s\n",
              r_H, if (ok_b) "OK" else "FOUT"))
  ## (c) alpha-kalibratie
  grad_F <- make_grad_F(fit)
  cal <- tryCatch(calibrate_alpha(grad_F, th0, H_obs), error = function(e) NULL)
  ok_c <- !is.null(cal) && is.finite(cal$spread) && cal$spread < 0.01
  cat(sprintf("  (c) alpha-kalibratie   : alpha = %.4f, spread = %.2e     %s\n",
              if (is.null(cal)) NA else cal$alpha,
              if (is.null(cal)) NA else cal$spread,
              if (ok_c) "OK" else "FOUT"))
  ## (d) T-tensor vs directe derde afgeleide
  ok_d <- FALSE
  if (ok_c) {
    T_arr <- compute_T_tensor_grad(grad_F, th0, cal$alpha)
    f_tot <- function(th) -sum(compute_loglik_casewise(fit, th)) / N
    hh <- 1e-3
    k <- which.max(abs(T_arr[cbind(1:D, 1:D, 1:D)]))
    pert <- function(sgn) { th <- th0; th[k] <- th[k] + sgn*hh; th }
    t_dir <- (f_tot(pert(2)) - 2*f_tot(pert(1)) + 2*f_tot(pert(-1)) -
                f_tot(pert(-2))) / (2*hh^3)
    r_T <- T_arr[k, k, k] / t_dir
    ok_d <- is.finite(r_T) && abs(r_T - 1) < 0.05
    cat(sprintf("  (d) T-tensor           : ratio = %+.6f (verwacht +1)   %s\n",
                r_T, if (ok_d) "OK" else "FOUT"))
  } else cat("  (d) T-tensor           : overgeslagen (alpha faalde)      FOUT\n")
  ## (e) [S7] V_inf-route: inverted.information.expected/N = vcov(se="standard")
  fit_std <- sem("f =~ x1 + x2 + x3", data = HolzingerSwineford1939,
                 estimator = "ML", se = "standard")
  V_std <- lavInspect(fit_std, "vcov")
  V_inf <- lavTech(fit, "inverted.information.expected") / N
  r_e <- max(abs(V_inf / V_std - 1), na.rm = TRUE)
  ok_e <- is.finite(r_e) && r_e < 1e-6
  cat(sprintf("  (e) V_inf-schaal       : max rel. afwijking = %.2e      %s\n",
              r_e, if (ok_e) "OK" else "FOUT"))
  ## (f) [S2] VITA/covsim: zichtbare nonnormaliteit + covariance-check
  set.seed(SEED_BASE)
  dat_vita <- simulate_vita_data(50000L, "correct", center = TRUE)
  md <- moment_diag(dat_vita)
  dS <- max(abs(cov(dat_vita)[ov_names, ov_names] - Sigma_pop))
  ok_f <- abs(mean(md$skew) - VITA_SKEW_TARGET) < 0.35 &&
    abs(mean(md$exkurt) - VITA_EXKURT_TARGET) < 1.75
  cat(sprintf("  (f) VITA/covsim        : skew = %.2f (doel %.2f), exc.kurt = %.2f (doel %.2f),\n",
              mean(md$skew), VITA_SKEW_TARGET, mean(md$exkurt), VITA_EXKURT_TARGET))
  cat(sprintf("                           max|S - Sigma_pop| = %.4f          %s\n",
              dS, if (ok_f) "OK" else "FOUT"))
  cat("      NB: dS is diagnostisch, niet het estimand-anker; voor nonnormal\n")
  cat("      worden pseudo-ware waarden via dezelfde VITA-DGP geschat.\n")
  ok <- ok_a && ok_b && ok_c && ok_d && ok_e && ok_f
  if (ok) cat("  Zelftest GESLAAGD.\n\n") else
    warning("Zelftest MISLUKT: los dit EERST op; hoij2 en/of wald_inf ",
            "zullen anders NA of onjuiste schaal geven.", call. = FALSE)
  invisible(ok)
}
selftest()


