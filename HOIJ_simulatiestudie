elapsed_sec <- function(t0) {
  ## proc.time()[3] heeft de naam "elapsed"; as.numeric() voorkomt dat
  ## samengestelde namen zoals "wald_inf.elapsed" ontstaan en later met
  ## tms[["wald_inf"]] niet meer teruggevonden worden.
