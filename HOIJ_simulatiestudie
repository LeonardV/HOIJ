# 5. FUNCTIONALEN
#    ab          : transformatie-geinduceerde scheefheid
#    psi_speed   : identity functional voor speed~~speed; elke bootstrap-
#                  scheefheid komt uit de reweighted estimator zelf
#    r2_speed    : verklaarde variantie in de speed-vergelijking,
#                  R^2_speed = 1 - psi_speed / Var(speed)
#    omega_speed : bounded ratio voor de speed-factor; secundaire diagnose
# ─────────────────────────────────────────────────────────────────────────────

fn_names <- TABLE_FNS

## Hulpfuncties op het niveau van vrije parameter-vectoren/matrices.
## speed is endogeen:
## Var(speed) = a^2 * Var(textual) + psi_speed.
var_speed_scalar <- function(th) {
  as.numeric(th["a"])^2 * as.numeric(th["textual~~textual"]) +
    as.numeric(th["speed~~speed"])
}

var_speed_vec <- function(mat, nms) {
  mat[, nms == "a"]^2 * mat[, nms == "textual~~textual"] +
    mat[, nms == "speed~~speed"]
}

functionals_scalar <- list(
  ab = function(th) {
    as.numeric(th["a"] * th["b"])
  },
  
  psi_speed = function(th) {
    as.numeric(th["speed~~speed"])
  },
  
  r2_speed = function(th) {
    psi <- as.numeric(th["speed~~speed"])
    var_s <- var_speed_scalar(th)
    if (!is.finite(var_s) || var_s < 1e-12) return(NA_real_)
    1 - psi / var_s
  },
  
  omega_speed = function(th) {
    ls    <- 1 + as.numeric(th["speed=~x8"]) + as.numeric(th["speed=~x9"])
    var_s <- var_speed_scalar(th)
    num   <- ls^2 * var_s
    den   <- num + as.numeric(th["x7~~x7"]) + as.numeric(th["x8~~x8"]) +
      as.numeric(th["x9~~x9"])
    if (!is.finite(den) || abs(den) < 1e-12) return(NA_real_)
    num / den
  }
)

functionals_vec <- list(
  ab = function(mat, nms) {
    mat[, nms == "a"] * mat[, nms == "b"]
  },
  
  psi_speed = function(mat, nms) {
    mat[, nms == "speed~~speed"]
  },
  
  r2_speed = function(mat, nms) {
    psi <- mat[, nms == "speed~~speed"]
    var_s <- var_speed_vec(mat, nms)
    res <- 1 - psi / var_s
    res[!is.finite(var_s) | var_s < 1e-12] <- NA_real_
    res
  },
  
  omega_speed = function(mat, nms) {
    ls    <- 1 + mat[, nms == "speed=~x8"] + mat[, nms == "speed=~x9"]
    var_s <- var_speed_vec(mat, nms)
    num   <- ls^2 * var_s
    den   <- num + mat[, nms == "x7~~x7"] + mat[, nms == "x8~~x8"] +
      mat[, nms == "x9~~x9"]
    res <- num / den
    res[!is.finite(den) | abs(den) < 1e-12] <- NA_real_
    res
  }
)

stopifnot(
  identical(fn_names, c("ab", "psi_speed", "r2_speed", "omega_speed")),
  all(fn_names %in% names(functionals_scalar)),
  all(fn_names %in% names(functionals_vec)),
  !"omega_vis" %in% fn_names
)

## Verificatie van de gesloten omega-vorm tegen de lavaan-route
## (cov.lv + theta). Fouten hier zouden alle omega-resultaten contamineren,
## dus harde stop [geen stille degradatie].
check_omega_forms <- function(fit) {
  th   <- coef(fit, type = "free")
  
  ## lavaan accepteert modelmatrices niet als losse lavInspect()-objecten
  ## in alle versies. Gebruik daarom de stabielere route via object = "est".
  estm <- lavInspect(fit, "est")
  clv  <- lavInspect(fit, "cov.lv")
  Th   <- estm$theta
  Lam  <- estm$lambda
  
  ref <- function(f, ind) {
    lsum <- sum(Lam[ind, f])
    num  <- lsum^2 * clv[f, f]
    num / (num + sum(diag(Th)[ind]))
  }
  
  o_s <- ref("speed", paste0("x", 7:9))
  
  stopifnot(abs(o_s - functionals_scalar$omega_speed(th)) < 1e-10)
  
  ## Extra harde checks voor de twee nieuwe speed-functionalen.
  stopifnot(abs(functionals_scalar$psi_speed(th) -
                  as.numeric(th["speed~~speed"])) < 1e-12)
  stopifnot(abs(functionals_scalar$r2_speed(th) -
                  (1 - as.numeric(th["speed~~speed"]) / clv["speed", "speed"])) < 1e-10)
  
  cat(sprintf(
    "Functional-vormcheck OK: psi_speed = %.4f, r2_speed = %.4f, omega_speed = %.4f\n",
    functionals_scalar$psi_speed(th), functionals_scalar$r2_speed(th), o_s
  ))
  
  invisible(c(
    psi_speed = functionals_scalar$psi_speed(th),
    r2_speed = functionals_scalar$r2_speed(th),
    omega_speed = o_s
  ))
}
